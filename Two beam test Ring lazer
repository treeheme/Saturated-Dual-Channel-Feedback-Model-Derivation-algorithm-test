#!/usr/bin/env python3
"""
Two-beam competition in the ring laser (cross-saturation), SDCF arms.

Beams:  dIj/dt = kappa*Ij*(N - 1 - s*(Ij + theta*I_other)) + sp*N - b*(Ij - I_other) + noise
  theta < 1 : beams coexist (stable bidirectional)      theta > 1 : winner-take-all
Reservoir arms (same as before): A_standard, B_sdcf, C_sdcf_leak.
Arm D_weighted_selfsat (MY CONSTRUCTION, not from your model): C, but each
beam's own saturation is weighted by its SDCF channel weight, so the
stronger beam saturates more (w1=u^(c*x), w2=u^(-c*x)). At c=0 it equals C.
All arms are tuned to the same operating point (same N and total output)
for each theta. Pump: 3% noise + the same three outage windows.
"""
import numpy as np, pandas as pd
from scipy.optimize import brentq
from scipy.ndimage import uniform_filter1d

ALPHA, BETA, U, TS, EPS = 0.90, 0.75, 1.03, 60.0, 1e-12
KAPPA, SP, BACK, SSAT = 40.0, 1e-3, 0.05, 0.10
P0, DT, DUR, DEC, NS = 3.0, 0.005, 240.0, 10, 16
WINDOWS = [(55.0, 76.0), (116.0, 139.0), (179.0, 201.0)]


def operating_point(theta):
    if theta < 1:
        f = lambda I: (1 + SSAT * I * (1 + theta)) * (1 + 2 * I) - P0
        I = brentq(f, 0, 5); It = 2 * I; N = 1 + SSAT * I * (1 + theta)
    else:
        f = lambda I: (1 + SSAT * I) * (1 + I) - P0
        It = brentq(f, 0, 5); N = 1 + SSAT * It
    return N, It


def tune(theta):
    N, It = operating_point(theta)
    lam0 = It / (1 + BETA * It)
    return dict(B_sdcf=1 / (ALPHA * N * lam0), C=(P0 - N) / (ALPHA * N * P0 * lam0)), N, It


def lam_x(t, I1, I2, c):
    x = (I1 - I2) / (I1 + I2 + EPS); tau = t / TS
    z = I1 * U ** (tau + c * x) + I2 * U ** (tau - c * x)
    return z / (1 + BETA * z), x


def rhs(arm, c, theta, C3, t, N, I1, I2, P):
    lam, x = lam_x(t, I1, I2, c)
    if arm == "D_weighted_selfsat":
        w1, w2 = U ** (c * x), U ** (-c * x)
    else:
        w1 = w2 = 1.0
    g1 = N - 1 - SSAT * (w1 * I1 + theta * I2)
    g2 = N - 1 - SSAT * (w2 * I2 + theta * I1)
    if arm == "A_standard":
        dN = P - N - N * (I1 + I2)
    elif arm == "B_sdcf":
        dN = P - ALPHA * N * P * C3["B_sdcf"] * lam
    else:
        dN = P - ALPHA * N * P * C3["C"] * lam - N
    return (dN, KAPPA * I1 * g1 + SP * N - BACK * (I1 - I2), KAPPA * I2 * g2 + SP * N - BACK * (I2 - I1))


def run(arm, c, theta, C3, seed0=0):
    rng = np.random.default_rng(300 + seed0)
    nt = int(round(DUR / DT)); t_arr = np.arange(nt + 1) * DT
    ou = np.zeros((nt + 1, NS)); a = DT / 2.0
    for k in range(nt):
        ou[k + 1] = ou[k] - a * ou[k] + 0.03 * np.sqrt(2 * a) * rng.standard_normal(NS)
    P = P0 * (1 + ou)
    for s, e in WINDOWS:
        P[(t_arr >= s) & (t_arr < e)] = 0.0
    N0, It0 = operating_point(theta)
    N = np.full(NS, N0); I1 = np.full(NS, 0.6 * It0); I2 = np.full(NS, 0.4 * It0)
    rec = np.zeros((nt // DEC + 1, 3, NS))
    for k in range(nt):
        t = t_arr[k]; p = P[k]
        if k % DEC == 0: rec[k // DEC] = [N, I1, I2]
        f = lambda dt, n, i1, i2, tt: rhs(arm, c, theta, C3, tt, n, i1, i2, p)
        k1 = f(0, N, I1, I2, t)
        k2 = f(0, N + DT / 2 * k1[0], I1 + DT / 2 * k1[1], I2 + DT / 2 * k1[2], t + DT / 2)
        k3 = f(0, N + DT / 2 * k2[0], I1 + DT / 2 * k2[1], I2 + DT / 2 * k2[2], t + DT / 2)
        k4 = f(0, N + DT * k3[0], I1 + DT * k3[1], I2 + DT * k3[2], t + DT)
        N = np.maximum(0, N + DT / 6 * (k1[0] + 2 * k2[0] + 2 * k3[0] + k4[0]))
        I1 = np.maximum(1e-6, I1 + DT / 6 * (k1[1] + 2 * k2[1] + 2 * k3[1] + k4[1]) + 0.05 * np.sqrt(I1 * DT) * rng.standard_normal(NS))
        I2 = np.maximum(1e-6, I2 + DT / 6 * (k1[2] + 2 * k2[2] + 2 * k3[2] + k4[2]) + 0.05 * np.sqrt(I2 * DT) * rng.standard_normal(NS))
    rec[-1] = [N, I1, I2]
    return np.arange(rec.shape[0]) * DT * DEC, rec


def metrics(t, rec):
    I1, I2 = rec[:, 1], rec[:, 2]; It = I1 + I2; x = (I1 - I2) / (It + EPS)
    steady = (t > 25)
    for s, e in WINDOWS: steady &= ~((t >= s) & (t < e + 25))
    base = uniform_filter1d(It, size=100, axis=0, mode="nearest")
    rin = 100 * ((It - base)[steady].std(axis=0) / It[steady].mean(axis=0)).mean()
    sw, nd = 0, 0
    for s, e in WINDOWS:
        pre = x[(t >= s - 10) & (t < s)].mean(axis=0); post = x[(t >= e + 20) & (t < e + 35)].mean(axis=0)
        ok = (np.abs(pre) > 0.5) & (np.abs(post) > 0.5)
        sw += int((np.sign(pre[ok]) != np.sign(post[ok])).sum()); nd += int(ok.sum())
    flips = []
    for j in range(NS):
        xs = x[steady[:, ] , j]; st = np.where(xs > 0.5, 1, np.where(xs < -0.5, -1, 0)); st = st[st != 0]
        flips.append(int((np.diff(st) != 0).sum()))
    return dict(mean_abs_x=float(np.abs(x[steady]).mean()), sd_x=float(x[steady].std()), RIN_pct=float(rin),
                outage_switch_rate=(sw / nd if nd else np.nan), outages_with_winner=nd, hops_per_run=float(np.mean(flips)),
                mean_I_steady=float(It[steady].mean()))


if __name__ == "__main__":
    rows = []; traj = {}
    for theta in (0.5, 1.5):
        C3, N0, It0 = tune(theta)
        print(f"theta={theta}: operating point N={N0:.3f}, I_total={It0:.3f}", flush=True)
        for arm, c in [("A_standard", 0.0), ("B_sdcf", 0.0), ("B_sdcf", 8.0), ("C_sdcf_leak", 0.0), ("C_sdcf_leak", 8.0),
                       ("D_weighted_selfsat", 8.0)]:
            t, rec = run("C_sdcf_leak" if arm == "C_sdcf_leak" else arm, c, theta, C3)
            rows.append(dict(theta=theta, arm=arm, c=c, **metrics(t, rec)))
            traj[(theta, arm, c)] = (t, rec[:, :, 0])
            print("  done", arm, c, flush=True)
    df = pd.DataFrame(rows); df.to_csv("results/ring_laser_two_beams.csv", index=False)
    pd.set_option("display.width", 220); pd.set_option("display.max_columns", 20)
    print(df.round(3).to_string(index=False))
    np.save("results/ringlaser_two_beams_traj.npy", {str(k): v for k, v in traj.items()}, allow_pickle=True)
