#!/usr/bin/env python3
"""
Advanced Ring Laser Gyroscope Simulation (Stress Test: BACK_SCATTER = 0.2)
Tests whether the SDCF-driven frequency bias can survive extreme mirror backscattering.
"""
import numpy as np
import matplotlib.pyplot as plt

# Parameters
ALPHA, BETA, U, TS, EPS = 0.90, 0.75, 1.03, 60.0, 1e-12
KAPPA, SP = 40.0, 1e-3
BACK_SCATTER = 0.20  # EXTREME Backscattering coupling strength (heavy lock-in pressure)
ROTATION_RATE = 0.02 # Sagnac frequency split input
BIAS_GAIN = 0.5      # Strength of SDCF-driven frequency bias coupling
P0, DT, DUR = 3.0, 0.001, 100.0

def run_stress_test(c_val=8.0):
    nt = int(round(DUR / DT))
    t_arr = np.arange(nt + 1) * DT
    
    E1 = np.zeros(nt + 1, dtype=complex)
    E2 = np.zeros(nt + 1, dtype=complex)
    N = np.zeros(nt + 1)
    
    E1[0] = np.sqrt(1.2) * np.exp(1j * 0.0)
    E2[0] = np.sqrt(0.8) * np.exp(1j * 0.0)
    N[0] = 1.0
    
    Z0 = P0 - 1.0
    LAM0 = Z0 / (1 + BETA * Z0)
    C3 = 1.0 / (ALPHA * LAM0)

    for k in range(nt):
        t = t_arr[k]
        I1 = np.abs(E1[k])**2
        I2 = np.abs(E2[k])**2
        It = I1 + I2 + EPS
        x = (I1 - I2) / It
        tau = t / TS
        
        z = I1 * U ** (tau + c_val * x) + I2 * U ** (tau - c_val * x)
        lam = z / (1 + BETA * z)
        
        dN_dt = P0 - ALPHA * N[k] * P0 * C3 * lam - N[k]
        N[k+1] = np.maximum(0, N[k] + dN_dt * DT)
        
        omega_bias = BIAS_GAIN * x * lam
        psi = np.angle(E1[k]) - np.angle(E2[k])
        
        dE1_dt = 0.5 * (KAPPA * (N[k] - 1.0) + 1j * (ROTATION_RATE + omega_bias)) * E1[k] + BACK_SCATTER * E2[k] * np.exp(1j * psi)
        dE2_dt = 0.5 * (KAPPA * (N[k] - 1.0) - 1j * (ROTATION_RATE + omega_bias)) * E2[k] + BACK_SCATTER * E1[k] * np.exp(-1j * psi)
        
        E1[k+1] = E1[k] + dE1_dt * DT
        E2[k+1] = E2[k] + dE2_dt * DT

    return t_arr, np.abs(E1)**2, np.abs(E2)**2, N, np.angle(E1) - np.angle(E2)

if __name__ == "__main__":
    t, I1, I2, N, psi = run_stress_test(c_val=8.0)
    beat_frequency = np.gradient(psi, DT)
    
    print(f"Stress test completed with BACK_SCATTER = {BACK_SCATTER}")
    print(f"Final Mean Beat Frequency: {np.mean(beat_frequency[50000:]):.4f} (Target: {ROTATION_RATE})")

    # Plot results
    plt.figure(figsize=(10, 6))
    plt.subplot(2, 1, 1)
    plt.plot(t, I1, label="I1 (CW)", color="blue")
    plt.plot(t, I2, label="I2 (CCW)", color="orange")
    plt.ylabel("Intensities (Stress Test)")
    plt.legend()
    
    plt.subplot(2, 1, 2)
    plt.plot(t, beat_frequency, label="Beat Frequency", color="purple")
    plt.axhline(ROTATION_RATE, color='red', linestyle='--', label=f"Target ({ROTATION_RATE})")
    plt.ylabel("Frequency")
    plt.xlabel("Time (s)")
    plt.legend()
    
    plt.tight_layout()
    plt.show()
